# MongoDB Atlas connection string
MONGODB_URI=

# Google OAuth (Google Cloud Console > Credentials > OAuth Client ID, Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local: http://localhost:3000/auth/google/callback
# Prod:  https://<tu-dominio>/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Único email permitido para entrar al dashboard
ALLOWED_EMAIL=elfora.dev@gmail.com

# Secreto de cookie de sesión: openssl rand -base64 32
SESSION_SECRET=

# Cloudinary (https://cloudinary.com > Dashboard)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
